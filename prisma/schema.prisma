generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  clerkId      String?  @unique // Legacy identifier retained only for existing rows.
  username     String   @unique
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  scores         Score[]
  messages       Message[]
  debatesCreated Debate[]    @relation("Creator")
  debatesPro     Debate[]    @relation("ProUser")
  debatesCon     Debate[]    @relation("ConUser")
  userBadges     UserBadge[]
  sessions       Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Debate {
  id                String    @id @default(cuid())
  topic             String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  duration          Int       @default(180)
  status            String    @default("waiting")
  startTime         DateTime?
  endTime           DateTime?
  aiFeedback        Json?
  analysisStatus    String    @default("idle")
  analysisStartedAt DateTime?
  winner            String?
  proTranscript     String    @default("")
  conTranscript     String    @default("")
  joinCodeCon       String    @unique
  isPublic          Boolean   @default(true)
  proDisplayName    String?

  // Foreign Keys
  creatorId String
  proUserId String
  conUserId String?

  // Relations
  creator  User      @relation("Creator", fields: [creatorId], references: [id])
  proUser  User      @relation("ProUser", fields: [proUserId], references: [id])
  conUser  User?     @relation("ConUser", fields: [conUserId], references: [id])
  messages Message[]
  scores   Score[]

  @@index([status, createdAt])
  @@index([creatorId])
  @@index([proUserId])
  @@index([conUserId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  role      String
  senderId  String
  debateId  String

  // Relations
  debate Debate @relation(fields: [debateId], references: [id])
  sender User   @relation(fields: [senderId], references: [id])

  @@index([debateId, createdAt])
}

model Score {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  logic          Float
  clarity        Float
  persuasiveness Float
  tone           Float
  userId         String
  debateId       String

  // Relations
  debate Debate @relation(fields: [debateId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, debateId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([debateId])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  criteria    Json
  createdAt   DateTime @default(now())

  // Relations
  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  // Relations
  badge Badge @relation(fields: [badgeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
}
